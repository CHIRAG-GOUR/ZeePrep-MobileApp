||`### ZeePrep Faculty Insights: ${t.subject} (Grade ${t.grade})\n\n**1. Platform Data Summary:**\n\u2022 Class Average Accuracy: ${t.avgAccuracy||78}%\n\u2022 Focus Weak Topics: ${(t.weakTopics||["Numerical Methods"]).join(", ")}\n\n**2. Analytical Diagnosis:**\nStudents demonstrate solid Level 1 conceptual understanding but struggle with Level 2 multi-step numerical calculations under timed conditions.\n\n**3. Reteaching Recommendation:**\n\u2022 Conduct a 20-minute targeted drill on ${t.subject} multi-step problems.\n\u2022 Assign foundational Level 2 practice items from the institutional Question Bank.`},_e.generateSuperAdminCopilotResponse=async function(e,t){var n=`You are ZeePrep Super Admin AI Platform Copilot, an executive analytics advisor for educational institutional leadership.\nAdmin Query: "${e}"\nPlatform Telemetry: Total Accounts: ${t.totalUsers}, Faculty Count: ${t.teacherCount}, Students: ${t.studentCount}, Conducted Exams: ${t.totalExams}, Pass Ratio: ${t.passRatio||"92%"}.\n\nProvide executive level analysis covering:\n- Multi-school activity trends\n- Operational health & participation rates\n- Strategic recommendations for institutional growth.`,o=await i(n);return o||`### ZeePrep Executive Platform Audit\n\n**1. Executive Telemetry Overview:**\n\u2022 Total Registered Accounts: ${t.totalUsers}\n\u2022 Active Faculty Members: ${t.teacherCount}\n\u2022 Student Body: ${t.studentCount}\n\u2022 Institutional Exams Conducted: ${t.totalExams}\n\n**2. Operational Assessment:**\nPlatform stability remains HEALTHY with high student engagement. Exam participation is trending upwards across active academic sessions.`},_e.suggestQuestionItems=async function(e,t,n,s=3,c="level1"){var l=`You are ZeePrep AI Exam Generator. Generate ${s} high-quality curriculum-aligned exam questions.\nSubject: ${e}\nGrade: ${t}\nTopic: ${n||"Core Curriculum"}\nDifficulty Target: ${"level1"===c?"Level 1: Recall & direct formula application (1 mark)":"level2"===c?"Level 2: Mod